{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Allow loose versioning for LinuxServer images without suffix locking",
      "matchPackagePrefixes": [
        "lscr.io/linuxserver/",
        "ghcr.io/linuxserver/"
      ],
      "versioning": "loose"
    }
  ]
}
